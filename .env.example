##############################################
# iSeed (아이씨드) - 통합 환경변수 예시
#
# 사용법:
#   1) 이 파일을 .env 로 복사합니다.        copy .env.example .env
#   2) 아래 값 중 필요한 것을 채웁니다.
#   3) .\start.ps1 실행
#
# ⚠️ 실제 키 값은 이 파일이 아니라 .env 에만 적으세요. (.env 는 git 제외 대상)
##############################################

# ── 공개 주소 (로컬 데모면 비워 두면 localhost 로 동작) ────────────────
# 외부 서버(EC2 등)에 올릴 때만 공인 IP/도메인을 넣으세요.
PUBLIC_HOST=localhost

# ── 포트 ──────────────────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=8000
AIMODELS_PORT=8080

# ── AI 모델 서비스 (필수) ─────────────────────────────────────────
# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
# 그림 해석(LLM) + RAG 임베딩(models/embedding-001) 에 사용됩니다.
GEMINI_API_KEY=
# 503/429 대비 키 순환을 쓰려면 콤마로 여러 개 (선택)
GEMINI_API_KEYS=
# 일부 라이브러리가 참조 (보통 GEMINI_API_KEY 와 동일하게)
GOOGLE_API_KEY=

# 사용할 Gemini 모델 (그림 해석 + 챗봇 공통). 비우면 gemini-3.5-flash-lite
#   ⚠️ "gemini-2.5-flash-lite" 는 신규 사용자에게 제공 중단(404)
#   ⚠️ "gemini-flash-latest" 같은 -latest 별칭은 구글이 모델을 바꾸면 무료 한도도 바뀌니 피하세요
GEMINI_MODEL=gemini-3.5-flash-lite
# 챗봇만 다른 모델을 쓰고 싶을 때 (비우면 GEMINI_MODEL)
CHATBOT_MODEL=

# ── RAG / ChromaDB ───────────────────────────────────────────────
# 컨테이너 내부 경로. 호스트의 ./rag/chroma 가 여기에 마운트됩니다.
# 비워두면 기존 기본 경로(jsonToLlm/htp_knowledge_base)를 사용합니다.
HTP_DB_PATH=/app/rag/chroma
# 호스트 기준 경로 (스크립트/문서용)
CHROMA_DB_PATH=./rag/chroma
PAPER_PATH=./rag/papers
# 임베딩 모델 (색인과 검색이 반드시 같아야 합니다)
#   구버전 "models/embedding-001" 은 구글에서 제공 중단되었습니다(404).
RAG_EMBEDDING_MODEL=models/gemini-embedding-001

# ── Backend (선택) ────────────────────────────────────────────────
# 그림 분석 → 리포트 → 마음활동 핵심 플로우는 Backend 없이도 동작합니다.
# 로그인 / 분석 기록 저장 / 커뮤니티를 쓰려면 아래를 채우세요.
JWT_SECRET=change-me
JWT_EXPIRES_SEC=172800
BCRYPT_SALT_ROUNDS=10

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

MONGODB_URI=
MONGODB_DB_NAME=

S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OAuth (선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Frontend 빌드 시 주입되는 공개 변수 ──────────────────────────
# (compose 가 PUBLIC_HOST + 포트로 자동 구성하므로 보통 건드릴 필요 없음)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_AIMODELS_BASE_URL=http://localhost:8080
NEXT_PUBLIC_KAKAO_MAP_API_KEY=
