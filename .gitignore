iSeed-AiModels-Docker/image_to_json/uploads/
iSeed-AiModels-Docker/image_to_json/result/

# --- RAG 백업 ---
rag/chroma.bak/
rag/**/*.bak

# --- 로그/임시 ---
*.log
*.tmp
*.temp

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

