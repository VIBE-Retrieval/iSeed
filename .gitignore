# --- 환경/시크릿 (절대 커밋 금지) ---
.env
.env.*
!.env.example

# --- 의존성/빌드 산출물 ---
node_modules/
.next/
__pycache__/
*.py[cod]
venv/
.venv/
.venv-local/

# --- 분석 산출물 (런타임 생성) ---
